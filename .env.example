# Copy this file to .env and fill in real values. Never commit .env.

# Use anthropic for one provider, or gemini/groq/qwen for the fallback chain.
OGGY_LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
OGGY_MODEL=claude-sonnet-5
GEMINI_API_KEY=
OGGY_GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
OGGY_GROQ_MODEL=llama-3.3-70b-versatile
QWEN_API_KEY=
OGGY_QWEN_MODEL=qwen-plus
# Providers are tried left to right; providers without keys are skipped.
OGGY_PROVIDER_ORDER=gemini,groq,qwen
OGGY_PROVIDER_TIMEOUT_SECONDS=20
OGGY_MAX_TOKENS=2048

# Comma-separated list of directories OGGY is allowed to touch.
OGGY_ALLOWED_DIRS=~/oggy_workspace

# Comma-separated allow-list of executables the command tool may ever run.
OGGY_ALLOWED_COMMANDS=python,python3,pip,pip3,git,node,npm,ls,pytest,explorer

# name=path pairs, comma-separated. Empty path = resolved by the OS.
OGGY_ALLOWED_APPLICATIONS=code=code,terminal=,browser=

OGGY_DATA_DIR=./data
OGGY_MAX_AGENT_STEPS=8

OGGY_DEBUG=false
OGGY_HOST=127.0.0.1
OGGY_PORT=5050
